# sturn.toml — one per coordinated repo. Secrets never live here.

[repo]
dir = "."                 # the git repo being coordinated
# id = "9aia/sturn"       # topic prefix; defaults to dir basename
# branch = "main"         # snap target

# [wal]
# ref_prefix = "refs/sturn/wal"

# [bus]
# store = "~/.local/state/sturn/bus.redb"
# poll_ms = 100

# [actor]
# name = "agent-7"        # default: $STURN_ACTOR → $USER

# [hooks]
# post_op = "kuda sync"   # detached `sh -c` after a successful ref-moving
                          # verb (claim/write/snap/push/…) — best-effort,
                          # never fails the op. String or list; off by
                          # default. $STURN_POST_OP overrides.
